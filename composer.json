{
    "name": "obray/core",
    "description": "Simple PHP framework for websites and applications.",
    "license": "MIT",
    "require": {
        "php": ">=7.0",
        "psr/http-message": "1.0.*",
        "psr/log": "^1.1",
        "psr/container": "^1.0"
    },
    "scripts": {
        "test:migrations": [
            "php tests/MigrationDetectionTest.php",
            "php tests/ModelTriggersTest.php",
            "php tests/IndexTest.php"
        ]
    },
    "autoload": {
        "psr-4": {
            "obray\\core\\": "src",
            "obray\\data\\": "src/data",
            "obray\\containers\\": "src/container",
            "obray\\users\\": "src/users",
            "obray\\sessions\\": "src/sessions"
        }
    }
}
